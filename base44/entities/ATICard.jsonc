{
  "name": "ATICard",
  "type": "object",
  "properties": {
    "public_card_code": {
      "type": "string",
      "description": "Human-readable public code (e.g. ATI-CZ-SEP-M20C-000184-V2)"
    },
    "sequence_number": {
      "type": "number",
      "description": "Sequential issuance number (globally incrementing)"
    },
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Linked aircraft listing"
    },
    "aircraft_registration": {
      "type": "string",
      "description": "Snapshot of N-number / tail at issuance"
    },
    "aircraft_label": {
      "type": "string",
      "description": "Snapshot of year/make/model at issuance"
    },
    "aircraft_region": {
      "type": "string",
      "description": "Region token used in public code (CZ, US, EU, etc.)"
    },
    "aircraft_class": {
      "type": "string",
      "description": "Short class token (SEP, MEP, TP, JET, HEL)"
    },
    "aircraft_model_token": {
      "type": "string",
      "description": "Short model token used in code (e.g. M20C)"
    },
    "card_version": {
      "type": "number",
      "minimum": 1,
      "default": 1,
      "description": "Card version (bumped on regeneration)"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "basic",
        "pro",
        "verified",
        "marketplace_pack",
        "broker_pack"
      ],
      "default": "basic",
      "description": "Card product tier"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "active",
        "shared",
        "engaged",
        "converted",
        "expired",
        "archived",
        "transferred",
        "disputed",
        "suspended"
      ],
      "default": "issued",
      "description": "Card lifecycle status"
    },
    "issuer_entity": {
      "type": "string",
      "enum": [
        "ABOS",
        "PARTNER",
        "WHITELABEL"
      ],
      "default": "ABOS",
      "description": "Entity that issued the card (ABOS = platform issuer, PARTNER = co-branded partner, WHITELABEL = third-party reseller)"
    },
    "issuer_email": {
      "type": "string",
      "description": "Email of the user/admin that issued the card"
    },
    "subject_owner_email": {
      "type": "string",
      "description": "Email of the aircraft beneficial owner"
    },
    "subject_operator_email": {
      "type": "string",
      "description": "Email of the aircraft operator"
    },
    "card_owner_email": {
      "type": "string",
      "description": "Email of the user/entity licensed to use this card"
    },
    "distribution_owner_email": {
      "type": "string",
      "description": "Email of marketplace/broker with distribution rights"
    },
    "attribution_model": {
      "type": "string",
      "enum": [
        "first_verified_source",
        "weighted_multi_touch",
        "last_click"
      ],
      "default": "first_verified_source",
      "description": "Attribution rule for commissions (MVP: first_verified_source)"
    },
    "origin_source": {
      "type": "string",
      "description": "Origin channel at creation (direct, referral, import, api)"
    },
    "campaign_id": {
      "type": "string",
      "description": "Marketing campaign tag"
    },
    "referrer_entity_id": {
      "type": "string",
      "description": "Party that referred this card's creation"
    },
    "distribution_chain_depth": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "How many referral hops upstream"
    },
    "first_verified_source_id": {
      "type": "string",
      "description": "Locked first verified affiliate source (once set, cannot be overwritten except by admin audit)"
    },
    "first_verified_locked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the first-verified source was locked (ISO 8601 timestamp)"
    },
    "pricing_plan_id": {
      "type": "string",
      "description": "Reference to pricing plan"
    },
    "commission_scheme_id": {
      "type": "string",
      "description": "Reference to commission scheme"
    },
    "gross_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Gross revenue generated by this card (cumulative, USD)"
    },
    "net_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Net revenue after commissions (USD)"
    },
    "payout_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "allocated",
        "paid",
        "disputed"
      ],
      "default": "none"
    },
    "view_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Public card views"
    },
    "share_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Times shared"
    },
    "image_attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of uploaded images (photos, logbook scans, maintenance records) attached to this card"
    },
    "average_review_rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "default": 0,
      "description": "Aggregated average rating from approved ATICardReview entries (0-5, one decimal)"
    },
    "review_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Count of approved reviews"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the card was issued"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the card expires (optional)"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Free-form notes (max 1000 chars)"
    }
  },
  "required": [
    "public_card_code",
    "listing"
  ],
  "rls": {
    "create": {
      "data.issuer_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.issuer_email": "{{user.email}}"
        },
        {
          "data.card_owner_email": "{{user.email}}"
        },
        {
          "data.subject_owner_email": "{{user.email}}"
        },
        {
          "data.subject_operator_email": "{{user.email}}"
        },
        {
          "data.distribution_owner_email": "{{user.email}}"
        },
        {
          "data.status": {
            "$in": [
              "issued",
              "active",
              "shared"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.issuer_email": "{{user.email}}"
        },
        {
          "data.card_owner_email": "{{user.email}}"
        },
        {
          "data.subject_owner_email": "{{user.email}}"
        },
        {
          "data.subject_operator_email": "{{user.email}}"
        },
        {
          "data.distribution_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}