{
  "name": "ATICardReview",
  "type": "object",
  "properties": {
    "ati_card": {
      "type": "string",
      "relationType": "ATICard",
      "description": "Optional ATI score card linked to this review"
    },
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Public aircraft listing being reviewed"
    },
    "report_id": {
      "type": "string",
      "description": "Optional report identifier; never stores report contents"
    },
    "public_card_code": {
      "type": "string",
      "description": "Public ATI card reference"
    },
    "author_user_id": {
      "type": "string",
      "description": "Author user ID snapshot"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Author email snapshot"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Public reviewer display name"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating from 1 to 5"
    },
    "review_title": {
      "type": "string",
      "maxLength": 120,
      "description": "Review heading"
    },
    "review_text": {
      "type": "string",
      "maxLength": 1000,
      "description": "Public review text only"
    },
    "comment": {
      "type": "string",
      "maxLength": 1000,
      "description": "Legacy review text field"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "published",
        "rejected",
        "approved"
      ],
      "default": "pending",
      "description": "Moderation status; approved is retained for legacy reviews"
    },
    "moderated_by": {
      "type": "string",
      "description": "Admin email who moderated the review"
    },
    "moderated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional search description"
    }
  },
  "required": [
    "listing",
    "rating",
    "comment"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}",
          "data.status": "pending"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}",
          "data.status": "pending"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}