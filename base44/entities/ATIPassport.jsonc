{
  "name": "ATIPassport",
  "type": "object",
  "properties": {
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Related aircraft listing"
    },
    "triggered_by": {
      "type": "string",
      "relationType": "User",
      "description": "User who triggered the ATI analysis"
    },
    "ati_total": {
      "type": "number",
      "description": "Total ATI score (0-120)"
    },
    "documentation": {
      "type": "number",
      "description": "Documentation completeness (0-15)"
    },
    "technical": {
      "type": "number",
      "description": "Maintenance traceability (0-15)"
    },
    "transparency": {
      "type": "number",
      "description": "Engine health transparency (0-15)"
    },
    "transaction_ready": {
      "type": "number",
      "description": "Avionics quality (0-15)"
    },
    "usage_mission": {
      "type": "number",
      "description": "Usage / mission risk (0-15)"
    },
    "storage_exposure": {
      "type": "number",
      "description": "Storage & exposure (0-15)"
    },
    "config_clarity": {
      "type": "number",
      "description": "Configuration clarity (0-15)"
    },
    "market_readiness": {
      "type": "number",
      "description": "Market readiness (0-15)"
    },
    "score_label": {
      "type": "string",
      "description": "ATI score label (EXCEPTIONAL, STRONG BUY, FAIR, CAUTION, RED FLAGS, AVOID)"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of ATI analysis"
    },
    "strengths": {
      "type": "string",
      "description": "Identified strengths (newline-separated)"
    },
    "risks": {
      "type": "string",
      "description": "Identified risks (newline-separated)"
    },
    "recommendations": {
      "type": "string",
      "description": "Recommendations (newline-separated)"
    },
    "missing_data": {
      "type": "string",
      "description": "Missing critical data fields (newline-separated)"
    },
    "deal_radar_eligible": {
      "type": "boolean",
      "description": "Eligible for Deal Radar (ATI >= 93 and price >= 8% below market)"
    },
    "co_ownership_viable": {
      "type": "boolean",
      "description": "Co-ownership viable (asking price >= $150k)"
    },
    "omvm_value": {
      "type": "number",
      "description": "OMVM estimated value"
    },
    "deal_score": {
      "type": "number",
      "description": "Deal score"
    },
    "deal_label": {
      "type": "string",
      "description": "Deal label"
    },
    "discount_pct": {
      "type": "number",
      "description": "Discount percentage"
    },
    "ati_version": {
      "type": "string",
      "default": "v2",
      "description": "ATI algorithm version"
    },
    "stripe_payment_id": {
      "type": "string",
      "description": "Stripe payment identifier"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL to generated PDF report"
    }
  },
  "required": [
    "listing"
  ]
}