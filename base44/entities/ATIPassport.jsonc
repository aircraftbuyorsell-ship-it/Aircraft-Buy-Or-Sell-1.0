{
  "name": "ATIPassport",
  "type": "object",
  "properties": {
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Related aircraft listing"
    },
    "triggered_by": {
      "type": "string",
      "relationType": "User",
      "description": "User who triggered the ATI analysis"
    },
    "ati_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 120,
      "description": "Total ATI score (0\u2013120, sum of 8 dimensions \u00d7 15 pts each)"
    },
    "documentation": {
      "type": "number",
      "minimum": 0,
      "maximum": 15,
      "description": "Documentation completeness (0\u201315)"
    },
    "technical": {
      "type": "number",
      "minimum": 0,
      "maximum": 15,
      "description": "Maintenance traceability (0\u201315)"
    },
    "transparency": {
      "type": "number",
      "minimum": 0,
      "maximum": 15,
      "description": "Engine health transparency (0\u201315)"
    },
    "transaction_ready": {
      "type": "number",
      "minimum": 0,
      "maximum": 15,
      "description": "Avionics quality (0\u201315)"
    },
    "usage_mission": {
      "type": "number",
      "minimum": 0,
      "maximum": 15,
      "description": "Usage / mission risk (0\u201315)"
    },
    "storage_exposure": {
      "type": "number",
      "minimum": 0,
      "maximum": 15,
      "description": "Storage & exposure (0\u201315)"
    },
    "config_clarity": {
      "type": "number",
      "minimum": 0,
      "maximum": 15,
      "description": "Configuration clarity (0\u201315)"
    },
    "market_readiness": {
      "type": "number",
      "minimum": 0,
      "maximum": 15,
      "description": "Market readiness (0\u201315)"
    },
    "score_label": {
      "type": "string",
      "enum": [
        "EXCEPTIONAL",
        "STRONG BUY",
        "FAIR",
        "CAUTION",
        "RED FLAGS",
        "AVOID"
      ],
      "description": "ATI score label tied to total bands"
    },
    "ai_summary": {
      "type": "string",
      "maxLength": 500,
      "description": "AI-generated summary of ATI analysis (max 500 chars)"
    },
    "strengths": {
      "type": "string",
      "maxLength": 2000,
      "description": "Identified strengths (newline-separated)"
    },
    "risks": {
      "type": "string",
      "maxLength": 2000,
      "description": "Identified risks (newline-separated)"
    },
    "recommendations": {
      "type": "string",
      "maxLength": 2000,
      "description": "Recommendations (newline-separated)"
    },
    "missing_data": {
      "type": "string",
      "maxLength": 2000,
      "description": "Missing critical data fields (newline-separated)"
    },
    "deal_radar_eligible": {
      "type": "boolean",
      "description": "Eligible for Deal Radar (ATI \u2265 93 AND price \u2265 8% below market)"
    },
    "co_ownership_viable": {
      "type": "boolean",
      "description": "Co-ownership viable (asking price \u2265 $150k)"
    },
    "omvm_value": {
      "type": "number",
      "minimum": 0,
      "description": "OMVM estimated value (USD)"
    },
    "deal_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Deal score (0\u201310)"
    },
    "deal_label": {
      "type": "string",
      "enum": [
        "hot deal",
        "good deal",
        "fair",
        "overpriced"
      ],
      "description": "Human-readable deal classification"
    },
    "discount_pct": {
      "type": "number",
      "description": "Discount percentage vs OMVM (positive = below market)"
    },
    "ati_version": {
      "type": "string",
      "default": "v2",
      "description": "ATI algorithm version (e.g. v2)"
    },
    "stripe_payment_id": {
      "type": "string",
      "description": "Stripe payment identifier (when paid generation)"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL to generated PDF report"
    }
  },
  "required": [
    "listing"
  ],
  "rls": {
    "create": {
      "data.triggered_by": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}