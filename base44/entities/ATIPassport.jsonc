{
  "name": "ATIPassport",
  "type": "object",
  "properties": {
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Related aircraft listing (optional \u2014 Digital Twin can exist without a listing)"
    },
    "faa_aircraft_id": {
      "type": "string",
      "relationType": "FAAAircraft",
      "description": "Direct link to FAA registry record (Digital Twin anchor \u2014 decoupled from Listing)"
    },
    "registration": {
      "type": "string",
      "description": "Aircraft registration (N-Number or international marking) \u2014 primary Digital Twin identifier"
    },
    "icao_hex": {
      "type": "string",
      "description": "ICAO 24-bit hex address (ADS-B identifier)"
    },
    "serial_number": {
      "type": "string",
      "description": "Aircraft serial number"
    },
    "triggered_by": {
      "type": "string",
      "relationType": "User",
      "description": "User who triggered the ATI analysis"
    },
    "ati_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 120,
      "description": "Total ATI score (0\u2013120, sum of 8 dimensions \u00d7 15 pts each)"
    },
    "documentation": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "technical": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "transparency": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "transaction_ready": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "usage_mission": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "storage_exposure": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "config_clarity": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "market_readiness": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "score_label": {
      "type": "string",
      "enum": [
        "EXCEPTIONAL",
        "STRONG BUY",
        "FAIR",
        "CAUTION",
        "RED FLAGS",
        "AVOID"
      ]
    },
    "ai_summary": {
      "type": "string",
      "maxLength": 500
    },
    "strengths": {
      "type": "string",
      "maxLength": 2000
    },
    "risks": {
      "type": "string",
      "maxLength": 2000
    },
    "recommendations": {
      "type": "string",
      "maxLength": 2000
    },
    "missing_data": {
      "type": "string",
      "maxLength": 2000
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Federated provider skip logs (e.g. 'Engine spec not mapped for code: 17026')"
    },
    "data_conflict": {
      "type": "boolean",
      "default": false,
      "description": "Data Integrity Shield: true when \u22652 fields mismatch between FAA cache, adsbdb, and ADS-B traffic sources"
    },
    "data_confidence": {
      "type": "string",
      "enum": [
        "verified",
        "caution",
        "unverified"
      ],
      "description": "Data Confidence badge: verified = 3 agreeing sources, caution = 2, unverified = 1 or disagreement"
    },
    "data_conflict_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fields that disagree between data sources (e.g. icao_hex, serial_number)"
    },
    "data_sources_matched": {
      "type": "number",
      "description": "Number of independent data sources agreeing on core identity fields"
    },
    "integrity_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Data Integrity Shield last ran for this passport"
    },
    "deal_radar_eligible": {
      "type": "boolean"
    },
    "co_ownership_viable": {
      "type": "boolean"
    },
    "omvm_value": {
      "type": "number",
      "minimum": 0
    },
    "deal_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "deal_label": {
      "type": "string",
      "enum": [
        "hot deal",
        "good deal",
        "fair",
        "overpriced"
      ]
    },
    "discount_pct": {
      "type": "number"
    },
    "ati_version": {
      "type": "string",
      "default": "v2"
    },
    "live_market_avg": {
      "type": "number"
    },
    "live_min_price": {
      "type": "number"
    },
    "live_max_price": {
      "type": "number"
    },
    "live_listings_count": {
      "type": "number"
    },
    "market_data_source": {
      "type": "string",
      "enum": [
        "live",
        "cached",
        "none"
      ]
    },
    "stripe_payment_id": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "broker_id": {
      "type": "string",
      "description": "User ID of the assigned broker (after agreement is signed)"
    },
    "broker_agreement_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "active"
      ],
      "default": "none",
      "description": "Broker agreement lifecycle status"
    },
    "agreement_doc_url": {
      "type": "string",
      "description": "Signed broker agreement PDF URL"
    },
    "broker_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_for_sale": {
      "type": "boolean",
      "default": false,
      "description": "Whether this aircraft has an active marketplace listing"
    },
    "engine_spec_id": {
      "type": "string",
      "relationType": "EngineSpec",
      "description": "Linked engine specification (TBO, HP, fuel type)"
    },
    "engine_tbo_hours": {
      "type": "number",
      "description": "Denormalized TBO from EngineSpec for quick access"
    },
    "engine_remaining_pct": {
      "type": "number",
      "description": "Engine life remaining percentage (if engine_hours and TBO are known)"
    },
    "twin_initialized_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Digital Twin was first created"
    },
    "twin_last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When federated data was last refreshed"
    }
  },
  "required": [
    "registration"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "data.broker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "data.broker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}