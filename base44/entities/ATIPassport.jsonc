{
  "name": "ATIPassport",
  "type": "object",
  "properties": {
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Related aircraft listing"
    },
    "triggered_by": {
      "type": "string",
      "relationType": "User",
      "description": "User who triggered the ATI analysis"
    },
    "ati_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 120,
      "description": "Total ATI score (0\u2013120, sum of 8 dimensions \u00d7 15 pts each)"
    },
    "documentation": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "technical": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "transparency": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "transaction_ready": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "usage_mission": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "storage_exposure": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "config_clarity": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "market_readiness": {
      "type": "number",
      "minimum": 0,
      "maximum": 15
    },
    "score_label": {
      "type": "string",
      "enum": [
        "EXCEPTIONAL",
        "STRONG BUY",
        "FAIR",
        "CAUTION",
        "RED FLAGS",
        "AVOID"
      ]
    },
    "ai_summary": {
      "type": "string",
      "maxLength": 500
    },
    "strengths": {
      "type": "string",
      "maxLength": 2000
    },
    "risks": {
      "type": "string",
      "maxLength": 2000
    },
    "recommendations": {
      "type": "string",
      "maxLength": 2000
    },
    "missing_data": {
      "type": "string",
      "maxLength": 2000
    },
    "deal_radar_eligible": {
      "type": "boolean"
    },
    "co_ownership_viable": {
      "type": "boolean"
    },
    "omvm_value": {
      "type": "number",
      "minimum": 0
    },
    "deal_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "deal_label": {
      "type": "string",
      "enum": [
        "hot deal",
        "good deal",
        "fair",
        "overpriced"
      ]
    },
    "discount_pct": {
      "type": "number"
    },
    "ati_version": {
      "type": "string",
      "default": "v2"
    },
    "live_market_avg": {
      "type": "number",
      "description": "Live/cached market average price from ABOS Market Intelligence feed"
    },
    "live_min_price": {
      "type": "number",
      "description": "Live/cached market minimum price"
    },
    "live_max_price": {
      "type": "number",
      "description": "Live/cached market maximum price"
    },
    "live_listings_count": {
      "type": "number",
      "description": "Number of live market listings found for this aircraft type"
    },
    "market_data_source": {
      "type": "string",
      "enum": [
        "live",
        "cached",
        "none"
      ],
      "description": "Whether market data came from live API, cache fallback, or was unavailable"
    },
    "stripe_payment_id": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    }
  },
  "required": [
    "listing"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.triggered_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}