{
  "name": "AffiliateLink",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "maxLength": 50,
      "description": "Short unique slug used in URL (e.g. MKP001, BRK022)"
    },
    "owner_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the party that owns this link"
    },
    "owner_role": {
      "type": "string",
      "enum": [
        "issuer",
        "master_distributor",
        "marketplace",
        "broker",
        "sub_broker",
        "introducer",
        "closing_agent"
      ],
      "default": "marketplace",
      "description": "Role this owner plays in the chain"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "ati_card",
        "listing",
        "bundle",
        "checkout"
      ],
      "default": "ati_card",
      "description": "What kind of target this link points to"
    },
    "target_card": {
      "type": "string",
      "relationType": "ATICard",
      "description": "ATI card this link points to (if target_type=ati_card)"
    },
    "target_listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Listing this link points to (if target_type=listing)"
    },
    "campaign_id": {
      "type": "string",
      "maxLength": 100,
      "description": "Marketing campaign tag"
    },
    "commission_scheme_id": {
      "type": "string",
      "description": "Reference to commission scheme (resolved at conversion)"
    },
    "parent_link_slug": {
      "type": "string",
      "maxLength": 50,
      "description": "Upstream link slug \u2014 for building multi-level chains"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the link is currently active"
    },
    "click_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Total click count"
    },
    "lead_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Verified leads attributed to this link"
    },
    "conversion_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Closed conversions attributed to this link"
    },
    "last_click_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the most recent click"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Free-form notes (max 1000 chars)"
    }
  },
  "required": [
    "slug",
    "owner_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}