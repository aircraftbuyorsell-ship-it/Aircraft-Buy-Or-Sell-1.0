{
  "name": "AgentApproval",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "workflow_key": {
      "type": "string"
    },
    "requested_by_agent_key": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "maxLength": 500,
      "description": "Exactly what will happen if this is approved"
    },
    "action_category": {
      "type": "string",
      "enum": [
        "production_destructive_change",
        "production_data_delete",
        "security_permission_change",
        "billing_price_change",
        "stripe_product_change",
        "refund_above_threshold",
        "critical_deployment",
        "provider_credential_change",
        "policy_or_compliance_change",
        "publish_customer_information",
        "disable_security_control",
        "public_pricing_change",
        "irreversible_migration",
        "mandatory_skill_override",
        "other"
      ],
      "description": "Category from the ABOS approval policy. mandatory_skill_override is the only way to close a run with an unexecuted required skill."
    },
    "skill_id": {
      "type": "string",
      "description": "Set when the approval overrides a mandatory skill"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "high"
    },
    "justification": {
      "type": "string",
      "maxLength": 2000,
      "description": "Why the agent believes this action is warranted"
    },
    "payload": {
      "type": "object",
      "description": "Exact change set, before and after where applicable"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "withdrawn"
      ],
      "default": "pending"
    },
    "decided_by": {
      "type": "string",
      "description": "Email of the human who decided. Never an agent_key."
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_note": {
      "type": "string",
      "maxLength": 2000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "approval_id",
    "action",
    "action_category",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
