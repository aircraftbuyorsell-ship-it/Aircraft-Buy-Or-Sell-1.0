{
  "name": "AgentAuditLog",
  "type": "object",
  "properties": {
    "correlation_id": { "type": "string", "description": "Ties every record produced by one logical operation together" },
    "actor": { "type": "string", "description": "Email of the human, or 'system'. Never blank." },
    "agent_key": { "type": "string" },
    "workflow_key": { "type": "string" },
    "run_id": { "type": "string" },
    "skill_id": { "type": "string" },
    "action": { "type": "string", "maxLength": 300, "description": "What was attempted, in plain terms" },
    "action_category": {
      "type": "string",
      "enum": ["workflow_start", "workflow_transition", "workflow_complete", "skill_execute", "skill_denied", "skill_override", "task_dispatch", "approval_request", "approval_decision", "escalation", "registry_change", "permission_change", "data_write", "other"],
      "default": "other"
    },
    "target_type": { "type": "string" },
    "target_id": { "type": "string" },
    "before": { "type": "object", "description": "State before the change. Omitted, not empty, when there was none." },
    "after": { "type": "object" },
    "reason": { "type": "string", "maxLength": 1000 },
    "result": { "type": "string", "enum": ["success", "failure", "denied", "pending"], "default": "success" },
    "approval_id": { "type": "string", "description": "Set when the action was permitted by an approval" },
    "evidence_count": { "type": "number", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["actor", "action", "action_category", "result"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
