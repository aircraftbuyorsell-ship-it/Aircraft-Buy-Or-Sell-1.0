{
  "name": "AgentWorkflow",
  "type": "object",
  "properties": {
    "workflow_key": { "type": "string", "description": "Stable workflow identity (e.g. abos.workflow.aircraft_assess.v1)" },
    "name": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 1000 },
    "domain": { "type": "string" },
    "version": { "type": "string", "default": "v1" },
    "status": { "type": "string", "enum": ["ACTIVE", "DISABLED", "EXPERIMENTAL", "DEPRECATED"], "default": "EXPERIMENTAL" },
    "owner_agent_key": { "type": "string", "description": "Agent accountable for the outcome" },
    "orchestrator_key": { "type": "string", "description": "Agent that coordinates execution" },
    "allowed_agents": { "type": "array", "items": { "type": "string" }, "description": "agent_key values permitted to execute steps. Empty means owner and orchestrator only." },
    "trigger": { "type": "string", "enum": ["manual", "scheduled", "event", "api"], "default": "manual" },
    "required_skills": { "type": "array", "items": { "type": "string" }, "description": "Mandatory skill_id list. A run cannot reach COMPLETED until each has executed successfully, returned NOT_APPLICABLE, or been overridden by an approved override." },
    "optional_skills": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "allowed_entities": { "type": "array", "items": { "type": "string" } },
    "approval_required": { "type": "boolean", "default": false, "description": "Run must pass through APPROVAL_REQUIRED before EXECUTING" },
    "approval_actions": { "type": "array", "items": { "type": "string" }, "description": "Action categories within this workflow that always require human approval" },
    "evidence_required": { "type": "boolean", "default": true },
    "audit_required": { "type": "boolean", "default": true },
    "max_retries": { "type": "number", "default": 2, "minimum": 0 },
    "max_delegation_depth": { "type": "number", "default": 4, "minimum": 1 },
    "timeout_ms": { "type": "number", "default": 900000 },
    "sla_minutes": { "type": "number", "description": "Target wall-clock completion time; breaching it raises an escalation" },
    "output_contract": { "type": "object", "description": "JSON Schema the final outputs must satisfy" },
    "min_confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Runs finishing below this confidence go to REVIEW instead of COMPLETED" },
    "enabled": { "type": "boolean", "default": true }
  },
  "required": ["workflow_key", "name", "required_skills"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "id": { "$exists": true } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
