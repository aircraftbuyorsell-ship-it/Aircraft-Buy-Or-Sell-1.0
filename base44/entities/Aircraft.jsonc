{
  "name": "Aircraft",
  "type": "object",
  "properties": {
    "registration": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "status": {
      "type": "string"
    },
    "icao_hex": {
      "type": "string"
    },
    "faa_aircraft_id": {
      "type": "string",
      "relationType": "FAAAircraft"
    },
    "digital_twin_status": {
      "type": "string",
      "enum": [
        "active",
        "stale",
        "needs_review"
      ],
      "default": "active"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "registration"
  ]
}