{
  "name": "AircraftListing",
  "type": "object",
  "properties": {
    "registration": {
      "type": "string",
      "description": "Aircraft registration (e.g. N123AB)"
    },
    "make": {
      "type": "string",
      "description": "Manufacturer"
    },
    "model": {
      "type": "string",
      "description": "Aircraft model"
    },
    "year": {
      "type": "number"
    },
    "total_time": {
      "type": "number"
    },
    "engine_hours": {
      "type": "number"
    },
    "tbo": {
      "type": "number"
    },
    "last_annual": {
      "type": "string",
      "format": "date"
    },
    "avionics": {
      "type": "string"
    },
    "asking_price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "CZK",
        "CHF"
      ],
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "draft"
      ],
      "default": "active"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "ati_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "omvm_value": {
      "type": "number"
    },
    "deal_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "deal_label": {
      "type": "string",
      "enum": [
        "hot deal",
        "good deal",
        "fair",
        "overpriced"
      ]
    },
    "discount_pct": {
      "type": "number"
    },
    "ai_summary": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "photo_source": {
      "type": "string",
      "enum": [
        "adsbdb",
        "hf_generated",
        "none"
      ],
      "default": "none"
    },
    "owner": {
      "type": "string",
      "relationType": "User"
    },
    "pending_fee_usd": {
      "type": "number",
      "minimum": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "make",
    "model"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.visibility": "public"
        },
        {
          "data.owner": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}