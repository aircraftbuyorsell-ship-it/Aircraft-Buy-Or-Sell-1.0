{
  "name": "BillingEvent",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "description": "Amount in USD (positive=charge, negative=refund)"
    },
    "billing_period_end": {
      "type": "string",
      "format": "date",
      "description": "End of billing period"
    },
    "billing_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of billing period"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency",
      "enum": [
        "USD",
        "EUR"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "description": "Human-readable description"
    },
    "event_type": {
      "type": "string",
      "description": "Type of billing event",
      "enum": [
        "subscription_charge",
        "tier_upgrade_charge",
        "tier_upgrade_refund",
        "tier_downgrade_refund",
        "overuse_charge",
        "manual_adjustment",
        "refund"
      ]
    },
    "invoice_number": {
      "type": "string",
      "description": "Invoice/receipt number"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date",
      "description": "When next charge is due"
    },
    "payment_method": {
      "type": "string",
      "description": "How payment was made",
      "enum": [
        "stripe_card",
        "stripe_bank",
        "manual_invoice",
        "credit"
      ]
    },
    "payment_status": {
      "type": "string",
      "description": "Status of payment",
      "enum": [
        "pending",
        "processing",
        "succeeded",
        "failed",
        "refunded"
      ]
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was processed"
    },
    "related_tier_change": {
      "type": "string",
      "description": "Reference to TierChange entity (if applicable)"
    },
    "stripe_charge_id": {
      "type": "string",
      "description": "Stripe charge ID (for lookups)"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user"
    }
  },
  "required": [
    "user_email",
    "event_type",
    "amount",
    "payment_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}