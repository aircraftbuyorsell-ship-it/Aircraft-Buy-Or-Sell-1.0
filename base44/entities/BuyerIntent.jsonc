{
  "name": "BuyerIntent",
  "type": "object",
  "properties": {
    "buyer_email": {
      "type": "string",
      "description": "Buyer who initiated the connection"
    },
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Matched ABOS aircraft listing when available"
    },
    "external_url": {
      "type": "string",
      "description": "External listing URL supplied by the buyer"
    },
    "registration": {
      "type": "string",
      "description": "Aircraft registration supplied by the buyer"
    },
    "aircraft_label": {
      "type": "string",
      "description": "Aircraft description snapshot"
    },
    "status": {
      "type": "string",
      "enum": [
        "matched",
        "claim_pending",
        "claimed",
        "offer_open"
      ],
      "default": "claim_pending",
      "description": "Connection state"
    },
    "claim_token": {
      "type": "string",
      "description": "Unique token used in the seller claim link"
    },
    "seller_email": {
      "type": "string",
      "description": "Known seller email when matched"
    }
  },
  "required": [
    "buyer_email",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}