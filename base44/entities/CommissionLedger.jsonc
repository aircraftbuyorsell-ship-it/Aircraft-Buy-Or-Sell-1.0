{
  "name": "CommissionLedger",
  "type": "object",
  "properties": {
    "ati_card": {
      "type": "string",
      "relationType": "ATICard",
      "description": "Card the commission belongs to"
    },
    "public_card_code": {
      "type": "string",
      "description": "Denormalized card code for display"
    },
    "escrow_transaction": {
      "type": "string",
      "relationType": "EscrowTransaction",
      "description": "Finalized escrow transaction"
    },
    "listing_id": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Aircraft listing associated with the commission"
    },
    "seller_email": {
      "type": "string",
      "description": "Seller charged the finder fee"
    },
    "type": {
      "type": "string",
      "enum": [
        "finders_fee",
        "commission"
      ],
      "default": "commission",
      "description": "Ledger entry type"
    },
    "gross_amount": {
      "type": "number",
      "description": "Total gross sale amount in USD"
    },
    "commission_pool": {
      "type": "number",
      "description": "Total commission pool"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "level": {
      "type": "number",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "description": "Waterfall level"
    },
    "role": {
      "type": "string",
      "enum": [
        "issuer",
        "marketplace",
        "broker",
        "sub_broker"
      ],
      "description": "Payee role"
    },
    "payee_email": {
      "type": "string",
      "description": "Email of the payee"
    },
    "payee_slug": {
      "type": "string",
      "description": "Affiliate link slug that earned this commission"
    },
    "percentage": {
      "type": "number",
      "description": "Percentage of commission pool awarded"
    },
    "amount": {
      "type": "number",
      "description": "Calculated commission amount"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "allocated",
        "batched",
        "paid",
        "disputed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Commission lifecycle status"
    },
    "settlement": {
      "type": "string",
      "relationType": "Settlement",
      "description": "Settlement batch"
    },
    "partner_id": {
      "type": "string",
      "relationType": "PartnerConfig",
      "description": "Partner config for widget commissions"
    },
    "partner_name": {
      "type": "string",
      "description": "Denormalized partner name"
    },
    "attribution_reason": {
      "type": "string",
      "description": "Why this payee won attribution"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "role",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.payee_email": "{{user.email}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}