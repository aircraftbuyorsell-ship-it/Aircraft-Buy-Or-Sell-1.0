{
  "name": "DealerLead",
  "type": "object",
  "properties": {
    "cert_num": {
      "type": "string",
      "description": "FAA dealer certificate number"
    },
    "name": {
      "type": "string",
      "description": "Dealer / company name"
    },
    "street": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "US state (2-letter)"
    },
    "zip": {
      "type": "string"
    },
    "ownership_type": {
      "type": "string",
      "description": "FAA ownership type (Individual, LLC, Co-Owned, Partnership, Corporation, etc.)"
    },
    "cert_date": {
      "type": "string",
      "description": "Certificate issue date (YYYY-MM-DD or YYYYMMDD)"
    },
    "expiration": {
      "type": "string",
      "description": "Certificate expiration date"
    },
    "is_expired": {
      "type": "boolean",
      "default": false,
      "description": "Whether the dealer certificate is expired"
    }
  },
  "required": [
    "cert_num",
    "name"
  ]
}