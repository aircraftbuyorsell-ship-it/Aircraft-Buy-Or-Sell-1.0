{
  "name": "DecisionLog",
  "type": "object",
  "properties": {
    "decision_type": {
      "type": "string",
      "enum": [
        "ati_score",
        "deal_radar_eligible",
        "commission_split",
        "first_verified_source",
        "other"
      ],
      "description": "What kind of automated decision was made"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "listing",
        "ati_card",
        "escrow",
        "lead",
        "user",
        "other"
      ],
      "description": "What entity the decision is about"
    },
    "subject_id": {
      "type": "string",
      "description": "ID of the subject record"
    },
    "subject_label": {
      "type": "string",
      "description": "Human-readable identifier (e.g. N-number, card code, escrow id)"
    },
    "inputs": {
      "type": "object",
      "description": "Snapshot of the inputs fed to the rule"
    },
    "outputs": {
      "type": "object",
      "description": "What the rule decided / returned"
    },
    "rule_version": {
      "type": "string",
      "description": "Version tag of the rule used (e.g. ati_v2, waterfall_v1)"
    },
    "rule_source": {
      "type": "string",
      "description": "Where in the codebase the decision was made (file:function)"
    },
    "actor": {
      "type": "string",
      "description": "Who/what triggered the decision (email or 'system')"
    },
    "reasoning": {
      "type": "string",
      "description": "Optional explanation (AI summary, attribution reason, etc.)"
    }
  },
  "required": [
    "decision_type",
    "subject_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}