{
  "name": "DeveloperAccount",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the ABOS user who owns this developer account (unique)"
    },
    "company_name": {
      "type": "string",
      "maxLength": 150,
      "description": "Company or individual developer name"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Business contact email (may differ from login email)"
    },
    "website_url": {
      "type": "string",
      "format": "uri",
      "description": "Developer or company website"
    },
    "bio": {
      "type": "string",
      "maxLength": 500,
      "description": "Short developer bio shown on marketplace"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended"
      ],
      "default": "pending",
      "description": "Admin-managed developer account status"
    },
    "api_key": {
      "type": "string",
      "description": "Unique API key issued to this developer for ABOS platform access"
    },
    "webhook_signing_key": {
      "type": "string",
      "description": "Secret key ABOS uses to sign outbound webhook calls to this developer's tools"
    },
    "default_revenue_share_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 80,
      "default": 30,
      "description": "Default revenue share % applied to all tools (overridable per tool)"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "paypal",
        "stripe",
        "crypto",
        "none"
      ],
      "default": "none",
      "description": "Preferred payout method"
    },
    "payout_details": {
      "type": "object",
      "description": "Payout account details (bank IBAN, PayPal email, Stripe ID, etc.)"
    },
    "total_earnings_tokens": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Cumulative tokens earned across all tools"
    },
    "total_paid_out_tokens": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Cumulative tokens already paid out"
    },
    "tool_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Number of registered tools"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the developer account was approved by admin"
    },
    "approved_by": {
      "type": "string",
      "description": "Admin email who approved this developer account"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Internal admin notes"
    }
  },
  "required": [
    "user_email",
    "company_name"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}