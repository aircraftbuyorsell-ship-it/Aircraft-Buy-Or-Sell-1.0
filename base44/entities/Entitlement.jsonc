{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the ABOS user who holds this entitlement"
    },
    "product_key": {
      "type": "string",
      "enum": [
        "ATI_SCORE",
        "ATI_REPORT",
        "DEAL_ANALYSIS",
        "INVESTMENT",
        "PROFESSIONAL",
        "ATI_REPORT_PACK_5",
        "ATI_REPORT_PACK_10",
        "ATI_REPORT_PACK_25",
        "API_STARTER",
        "API_PROFESSIONAL",
        "API_ENTERPRISE",
        "WHITE_LABEL_LICENSE",
        "ATI_BASIC_REPORT",
        "ATI_PRO",
        "ATI_PRO_TAX",
        "ATI_FULL_REPORT",
        "VALUATION_STUDIO",
        "VERIFICATION_PACK",
        "PRO",
        "BROKER"
      ],
      "description": "ABOS product this entitlement grants access to"
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "aircraft"
      ],
      "default": "aircraft",
      "description": "global = subscription plan; aircraft = per-aircraft one-time purchase"
    },
    "aircraft_registration": {
      "type": "string",
      "description": "Aircraft registration for aircraft-scoped products"
    },
    "source": {
      "type": "string",
      "enum": [
        "stripe",
        "admin",
        "trial",
        "gifted"
      ],
      "default": "stripe"
    },
    "stripe_payment_id": {
      "type": "string",
      "description": "Stripe PaymentIntent or Checkout Session id"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe Subscription id"
    },
    "stripe_event_id": {
      "type": "string",
      "description": "Idempotency key for the Stripe event"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "refunded",
        "canceled"
      ],
      "default": "active"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "Subscription current period end"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for search visibility and SEO"
    }
  },
  "required": [
    "user_email",
    "product_key",
    "scope",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}