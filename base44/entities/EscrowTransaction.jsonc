{
  "name": "EscrowTransaction",
  "type": "object",
  "properties": {
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Related aircraft listing"
    },
    "aircraft_label": {
      "type": "string",
      "description": "Aircraft snapshot label (year make model reg)"
    },
    "buyer_name": {
      "type": "string",
      "description": "Buyer full name or company"
    },
    "buyer_email": {
      "type": "string",
      "description": "Buyer email"
    },
    "seller_name": {
      "type": "string",
      "description": "Seller full name or company"
    },
    "seller_email": {
      "type": "string",
      "description": "Seller email"
    },
    "broker_name": {
      "type": "string",
      "description": "Broker / finder name"
    },
    "broker_email": {
      "type": "string",
      "description": "Broker email"
    },
    "sale_amount": {
      "type": "number",
      "description": "Agreed sale price"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "CZK",
        "CHF"
      ],
      "default": "USD"
    },
    "finders_fee_pct": {
      "type": "number",
      "description": "Finder's fee percentage"
    },
    "finders_fee_amount": {
      "type": "number",
      "description": "Calculated finder's fee amount"
    },
    "seller_net": {
      "type": "number",
      "description": "Net amount seller receives"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "contract_sent",
        "contract_signed",
        "funds_pending",
        "funds_secured",
        "inspection",
        "released",
        "closed",
        "cancelled",
        "disputed"
      ],
      "default": "draft"
    },
    "escrow_provider": {
      "type": "string",
      "enum": [
        "internal",
        "escrow_com",
        "stripe",
        "usdc"
      ],
      "default": "internal"
    },
    "escrow_external_id": {
      "type": "string",
      "description": "Escrow.com transaction ID or Stripe session ID"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "usdc",
        "internal"
      ],
      "default": "internal",
      "description": "Payment method for escrow deposit"
    },
    "escrow_wallet_address": {
      "type": "string",
      "description": "Dedicated Ethereum wallet address for USDC deposits"
    },
    "escrow_wallet_encrypted_key": {
      "type": "string",
      "description": "AES-GCM encrypted private key for the escrow wallet"
    },
    "blockchain_tx_hash": {
      "type": "string",
      "description": "On-chain transaction hash for the USDC release payout to the seller"
    },
    "seller_usdc_payout_address": {
      "type": "string",
      "description": "Seller's USDC (Polygon) wallet address for release payout. Required before a USDC escrow can be released."
    },
    "usdc_amount_required": {
      "type": "number",
      "description": "USDC amount required to fund the escrow"
    },
    "usdc_amount_received": {
      "type": "number",
      "description": "USDC amount received on-chain"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "not_required",
        "required",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "not_required",
      "description": "KYC gate for USDC escrow funding above the compliance threshold (ARCH-004). Funds arriving on-chain are held until this is 'verified'."
    },
    "kyc_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When kyc_status was set to verified or rejected"
    },
    "kyc_verified_by": {
      "type": "string",
      "description": "Admin email who performed the manual KYC verification (no automated KYC provider is integrated yet)"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe checkout session ID for escrow deposit"
    },
    "partner_id": {
      "type": "string",
      "relationType": "PartnerConfig",
      "description": "Partner config for widget-originated transactions"
    },
    "partner_email": {
      "type": "string",
      "description": "Denormalized partner email for RLS"
    },
    "partner_revenue_share_pct": {
      "type": "number",
      "description": "Snapshot of partner revenue share percentage at transaction time"
    },
    "partner_revenue_share_amount": {
      "type": "number",
      "description": "Calculated ABOS revenue share amount"
    },
    "widget_origin": {
      "type": "boolean",
      "default": false,
      "description": "Whether this transaction originated from a partner widget"
    },
    "inspection_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled pre-buy inspection date"
    },
    "closing_deadline": {
      "type": "string",
      "format": "date",
      "description": "Transaction closing deadline"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event ID for inspection + closing events (comma-separated)"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "buyer_name",
    "seller_name",
    "sale_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.broker_email": "{{user.email}}"
        },
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "data.broker_email": "{{user.email}}"
        },
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "data.broker_email": "{{user.email}}"
        },
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}