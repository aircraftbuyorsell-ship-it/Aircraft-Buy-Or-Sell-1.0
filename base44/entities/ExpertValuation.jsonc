{
  "name": "ExpertValuation",
  "type": "object",
  "properties": {
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Listing this expert valuation applies to"
    },
    "aircraft_label": {
      "type": "string",
      "description": "Snapshot (year make model N-number)"
    },
    "model_omvm": {
      "type": "number",
      "description": "Model-generated OMVM at time of review"
    },
    "expert_omvm": {
      "type": "number",
      "description": "Expert-adjusted OMVM in USD"
    },
    "delta_pct": {
      "type": "number",
      "description": "Percentage delta between model and expert (expert vs model)"
    },
    "expert_email": {
      "type": "string",
      "description": "Reviewer email"
    },
    "expert_role": {
      "type": "string",
      "enum": [
        "appraiser",
        "broker",
        "admin",
        "other"
      ],
      "default": "appraiser"
    },
    "rationale": {
      "type": "string",
      "description": "Why the expert adjusted the price"
    },
    "factors_tagged": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "engine",
          "avionics",
          "airframe",
          "damage",
          "market_timing",
          "region",
          "paint_interior",
          "stc_mods",
          "usage",
          "other"
        ]
      },
      "description": "Structured factor tags feeding the calibration loop"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "applied_to_model"
      ],
      "default": "pending"
    }
  },
  "required": [
    "listing",
    "expert_omvm"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.expert_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.expert_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}