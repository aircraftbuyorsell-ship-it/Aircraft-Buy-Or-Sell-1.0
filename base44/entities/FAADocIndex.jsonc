{
  "name": "FAADocIndex",
  "type": "object",
  "properties": {
    "n_number": {
      "type": "string",
      "description": "N-Number (without N prefix)"
    },
    "total_docs": {
      "type": "number",
      "description": "Total FAA document filings"
    },
    "bos_count": {
      "type": "number",
      "description": "Bill of Sale count"
    },
    "sa_count": {
      "type": "number",
      "description": "Security Agreement count"
    },
    "rel_count": {
      "type": "number",
      "description": "Release count"
    },
    "latest_filing": {
      "type": "string",
      "description": "Most recent filing date (YYYYMMDD)"
    },
    "ati_score": {
      "type": "number",
      "description": "FAA-derived ATI documentation score (0-100)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for search visibility and SEO"
    }
  },
  "required": [
    "n_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}