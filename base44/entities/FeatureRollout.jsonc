{
  "properties": {
    "completed_at": {
      "description": "When rollout was completed (100% reached)",
      "format": "date-time",
      "type": "string"
    },
    "created_by": {
      "description": "Admin who created this rollout",
      "type": "string"
    },
    "current_percentage": {
      "default": 0,
      "description": "Current rollout percentage (0-100)",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "feature_name": {
      "description": "Reference to feature being rolled out",
      "type": "string"
    },
    "halted_at": {
      "description": "If rollout was halted, when it happened",
      "format": "date-time",
      "type": "string"
    },
    "halt_reason": {
      "description": "Why rollout was halted (bugs, performance, etc.)",
      "maxLength": 500,
      "type": "string"
    },
    "increments": {
      "default": [],
      "description": "Rollout schedule: [{date: 2026-05-25, percentage: 10}, {date: 2026-05-26, percentage: 25}, ...]",
      "items": {
        "properties": {
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "percentage": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "description": "Rollout status",
      "enum": [
        "planning",
        "active",
        "paused",
        "halted",
        "completed"
      ],
      "type": "string"
    },
    "target_percentage": {
      "default": 100,
      "description": "Final target percentage for rollout",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "tier": {
      "description": "Tier being rolled out to",
      "enum": [
        "free_explorer",
        "pro",
        "enterprise"
      ],
      "type": "string"
    },
    "updated_at": {
      "description": "Last update to rollout",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "feature_name",
    "tier",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": {
      "user_condition": {
        "role": [
          "admin",
          "super_admin"
        ]
      }
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  },
  "type": "object",
  "name": "FeatureRollout"
}