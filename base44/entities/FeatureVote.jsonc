{
  "name": "FeatureVote",
  "type": "object",
  "properties": {
    "feature_request": {
      "type": "string",
      "relationType": "FeatureRequest",
      "description": "The feature being voted on"
    },
    "voter_email": {
      "type": "string",
      "description": "Email of the voter"
    }
  },
  "required": [
    "feature_request",
    "voter_email"
  ],
  "rls": {
    "create": {
      "data.voter_email": "{{user.email}}"
    },
    "read": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "update": {
      "$or": [
        {
          "data.voter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.voter_email": "{{user.email}}"
    }
  }
}