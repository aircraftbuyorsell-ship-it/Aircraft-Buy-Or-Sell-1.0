{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "aircraft_preference": {
      "type": "string",
      "description": "Aircraft type preference"
    },
    "budget": {
      "type": "string",
      "description": "Preferred budget range"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "negotiating",
        "closed",
        "lost"
      ],
      "default": "new",
      "description": "Lead status"
    },
    "source": {
      "type": "string",
      "description": "Lead source"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Linked aircraft listing"
    },
    "listing_label": {
      "type": "string",
      "description": "Snapshot of aircraft (year make model N-number)"
    },
    "rules_agreed": {
      "type": "boolean",
      "default": false,
      "description": "Agreed to rules"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}