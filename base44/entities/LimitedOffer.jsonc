{
  "name": "LimitedOffer",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "aircraft_registration": {
      "type": "string"
    },
    "discount_pct": {
      "type": "number",
      "default": 0.3
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "aircraft_registration",
    "discount_pct",
    "expires_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}