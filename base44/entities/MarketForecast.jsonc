{
  "name": "MarketForecast",
  "type": "object",
  "properties": {
    "overall_sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "description": "Celkov\u00fd sentiment trhu"
    },
    "key_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Kl\u00ed\u010dov\u00e9 faktory ovliv\u0148uj\u00edc\u00ed trh"
    },
    "aircraft_trends": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Kategorie letadla (SEP, Turboprop, Light Jet, atd.)"
          },
          "popularity_trend": {
            "type": "string",
            "enum": [
              "growing",
              "stable",
              "declining"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Trendy popularit\u011b jednotliv\u00fdch kategori\u00ed letadel"
    },
    "price_changes_forecast": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "percentage_change": {
            "type": "number",
            "description": "O\u010dek\u00e1van\u00e1 zm\u011bna ceny v %"
          },
          "timeframe": {
            "type": "string"
          }
        }
      },
      "description": "P\u0159edpov\u011bdi cenov\u00fdch zm\u011bn"
    },
    "time_on_market_forecast": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "average_days": {
            "type": "number"
          },
          "trend": {
            "type": "string",
            "enum": [
              "shortening",
              "stable",
              "lengthening"
            ]
          }
        }
      },
      "description": "O\u010dek\u00e1van\u00fd \u010das na trhu pro jednotliv\u00e9 kategorie"
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identifikovan\u00e9 p\u0159\u00edle\u017eitosti na trhu"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identifikovan\u00e1 rizika na trhu"
    },
    "forecast_date": {
      "type": "string",
      "format": "date",
      "description": "Datum generov\u00e1n\u00ed p\u0159edpov\u011bdi"
    },
    "model_version": {
      "type": "string",
      "default": "gemini_3_1_pro",
      "description": "LLM model pou\u017eit\u00fd pro generov\u00e1n\u00ed"
    },
    "cache_key": {
      "type": "string",
      "description": "HF Intelligence cache key: ${make}_${model}_${horizon}"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this cached HF forecast expires (now + 6h)"
    },
    "hf_make": {
      "type": "string",
      "description": "Aircraft make for this HF forecast"
    },
    "hf_model": {
      "type": "string",
      "description": "Aircraft model for this HF forecast"
    },
    "hf_horizon_days": {
      "type": "number",
      "description": "Forecast horizon in days (30/60/90)"
    },
    "hf_forecast": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "number"
          },
          "price_low": {
            "type": "number"
          },
          "price_mid": {
            "type": "number"
          },
          "price_high": {
            "type": "number"
          }
        }
      },
      "description": "Chronos forecast: predicted prices per day with confidence band"
    },
    "hf_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "description": "Historical price series used as Chronos context"
    },
    "hf_sentiment": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "positive",
            "neutral",
            "negative"
          ]
        },
        "score": {
          "type": "number"
        }
      },
      "description": "FinBERT sentiment result"
    },
    "hf_signal": {
      "type": "string",
      "enum": [
        "BUY",
        "HOLD",
        "WATCH"
      ],
      "description": "Combined trading signal derived from forecast + sentiment"
    },
    "hf_ai_commentary": {
      "type": "string",
      "maxLength": 2000,
      "description": "AI-generated explanation of the forecast and signal"
    },
    "hf_current_price": {
      "type": "number",
      "description": "Latest historical price at forecast time"
    },
    "hf_forecast_change_pct": {
      "type": "number",
      "description": "Predicted % change over horizon"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for search visibility and SEO"
    }
  },
  "required": [
    "overall_sentiment",
    "key_factors",
    "aircraft_trends",
    "price_changes_forecast",
    "time_on_market_forecast",
    "opportunities",
    "risks",
    "forecast_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}