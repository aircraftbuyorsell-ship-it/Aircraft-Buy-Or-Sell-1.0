{
  "name": "MarketingPost",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram"
      ],
      "description": "Social channel used for publication"
    },
    "page_id": {
      "type": "string",
      "description": "Social account or Page identifier"
    },
    "page_name": {
      "type": "string",
      "description": "Social account or Page name at publish time"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "AircraftListing",
        "MarketReport",
        "AviationNewsItem",
        "custom"
      ]
    },
    "source_id": {
      "type": "string",
      "description": "Source record identifier"
    },
    "post_id": {
      "type": "string",
      "description": "Remote social post identifier"
    },
    "copy": {
      "type": "string",
      "maxLength": 5000
    },
    "link_url": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "failed"
      ],
      "default": "published"
    }
  },
  "required": [
    "channel",
    "page_id",
    "source_type",
    "post_id",
    "copy",
    "published_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}