{
  "name": "OAuthClient",
  "properties": {
    "client_id": {
      "description": "Public client identifier issued at registration (not secret)",
      "type": "string"
    },
    "client_name": {
      "description": "Human-readable name shown on the consent screen, e.g. 'Claude', 'ChatGPT'",
      "maxLength": 200,
      "type": "string"
    },
    "redirect_uris": {
      "description": "Allowlisted redirect URIs this client may be sent back to after consent",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "registered_via": {
      "default": "dynamic",
      "enum": [
        "dynamic",
        "manual"
      ],
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "client_name",
    "redirect_uris"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}