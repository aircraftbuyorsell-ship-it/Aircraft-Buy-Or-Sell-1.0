{
  "name": "Order",
  "type": "object",
  "properties": {
    "user": {
      "type": "string",
      "relationType": "User",
      "description": "User who placed the order"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "ati_passport",
        "report",
        "subscription"
      ],
      "description": "Type of product purchased"
    },
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Related aircraft listing"
    },
    "stripe_payment_intent": {
      "type": "string",
      "description": "Stripe PaymentIntent ID"
    },
    "amount": {
      "type": "number",
      "description": "Order amount"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Payment currency"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending",
      "description": "Payment status"
    },
    "paid_at": {
      "type": "string",
      "format": "date",
      "description": "Date of payment"
    }
  },
  "required": [
    "user"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}