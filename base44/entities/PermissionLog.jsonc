{
  "properties": {
    "action": {
      "description": "Type of permission action",
      "enum": [
        "role_granted",
        "role_revoked",
        "tier_upgraded",
        "tier_downgraded",
        "admin_override",
        "user_suspended",
        "user_unsuspended",
        "permission_added",
        "permission_revoked",
        "editor_access_granted",
        "editor_access_revoked"
      ],
      "type": "string"
    },
    "actor_email": {
      "description": "Admin or user who took the action",
      "type": "string"
    },
    "entity_id": {
      "description": "ID of affected entity",
      "type": "string"
    },
    "entity_type": {
      "description": "Entity affected (User, AircraftListing, ATICard, etc.)",
      "type": "string"
    },
    "ip_hash": {
      "description": "Hashed IP address of actor",
      "type": "string"
    },
    "new_value": {
      "description": "State after action",
      "type": "object"
    },
    "old_value": {
      "description": "State before action",
      "type": "object"
    },
    "reason": {
      "description": "Why the action was taken",
      "maxLength": 500,
      "type": "string"
    },
    "subject_email": {
      "description": "User affected by the action",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "action",
    "actor_email",
    "subject_email",
    "timestamp"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": {
      "user_condition": {
        "role": [
          "admin",
          "super_admin"
        ]
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object",
  "name": "PermissionLog"
}