{
  "name": "ProtocolRFC",
  "type": "object",
  "properties": {
    "rfc_id": {
      "type": "string",
      "description": "Protocol RFC identifier, for example RFC-001"
    },
    "title": {
      "type": "string",
      "description": "RFC title"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "candidate",
        "accepted",
        "implemented",
        "integrated",
        "archived"
      ],
      "default": "draft"
    },
    "category": {
      "type": "string",
      "enum": [
        "apl",
        "api",
        "events",
        "ati",
        "knowledge_graph",
        "mcp",
        "security",
        "identity",
        "discovery"
      ]
    },
    "author": {
      "type": "string"
    },
    "abstract": {
      "type": "string"
    },
    "motivation": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "rfc_id",
    "title",
    "status",
    "category",
    "author"
  ],
  "rls": {
    "read": {
      "id": {
        "$exists": true
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}