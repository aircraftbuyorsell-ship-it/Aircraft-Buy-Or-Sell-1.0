{
  "name": "PurchasedReport",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner of this purchased report"
    },
    "product_key": {
      "type": "string",
      "enum": [
        "ATI_SCORE",
        "ATI_REPORT",
        "DEAL_ANALYSIS",
        "INVESTMENT",
        "PROFESSIONAL",
        "ATI_FULL_REPORT",
        "VALUATION_STUDIO",
        "VERIFICATION_PACK"
      ],
      "description": "The one-time product this report was purchased under"
    },
    "aircraft_registration": {
      "type": "string",
      "description": "Aircraft this report covers"
    },
    "aircraft_label": {
      "type": "string"
    },
    "entitlement_id": {
      "type": "string",
      "relationType": "Entitlement"
    },
    "status": {
      "type": "string",
      "enum": [
        "entitled",
        "processing",
        "ready",
        "failed"
      ],
      "default": "entitled"
    },
    "report_type": {
      "type": "string"
    },
    "result_data": {
      "type": "object"
    },
    "pdf_url": {
      "type": "string"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider": {
      "type": "string",
      "default": "abos_omvm"
    },
    "provider_request_id": {
      "type": "string"
    },
    "methodology_version": {
      "type": "string",
      "default": "v1"
    },
    "inputs": {
      "type": "object"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "verified",
        "caution",
        "unverified"
      ]
    },
    "verification_status": {
      "type": "string"
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_email",
    "product_key",
    "aircraft_registration",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}