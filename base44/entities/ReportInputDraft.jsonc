{
  "name": "ReportInputDraft",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "aircraft_registration": {
      "type": "string"
    },
    "listing_text": {
      "type": "string"
    },
    "document_uris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "document_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "attached",
        "processed"
      ],
      "default": "draft"
    }
  },
  "required": [
    "user_email",
    "aircraft_registration",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}