{
  "name": "RewardMilestone",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user who earned the reward"
    },
    "milestone_type": {
      "type": "string",
      "enum": [
        "referral_verified",
        "ati_score_90",
        "ati_score_95",
        "first_ati_passport",
        "first_escrow",
        "manual_admin"
      ],
      "description": "Type of milestone achieved (formal enum, additions require schema update)"
    },
    "tokens_awarded": {
      "type": "number",
      "minimum": 0,
      "description": "Raw tokens credited (1 token = 5 displayed credits)"
    },
    "credits_awarded": {
      "type": "number",
      "minimum": 0,
      "description": "Credits granted (display units)"
    },
    "reference_id": {
      "type": "string",
      "description": "Entity id related to the milestone (listing id, invitee email, escrow id) \u2014 used for dedupe"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "listing",
        "user",
        "escrow",
        "ati_card",
        "other"
      ],
      "description": "Kind of reference"
    },
    "note": {
      "type": "string",
      "maxLength": 500,
      "description": "Human-readable description of the achievement (max 500 chars)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for search visibility and SEO"
    }
  },
  "required": [
    "user_email",
    "milestone_type",
    "tokens_awarded"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}