{
  "name": "SalesPipeline",
  "type": "object",
  "properties": {
    "registration": {
      "type": "string",
      "description": "Aircraft registration (N-Number or international)"
    },
    "passport_id": {
      "type": "string",
      "relationType": "ATIPassport",
      "description": "Digital Twin passport this pipeline is anchored to"
    },
    "listing_id": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Related marketplace listing (optional)"
    },
    "aircraft_label": {
      "type": "string",
      "description": "Human-readable aircraft summary (year make model reg)"
    },
    "aircraft_class": {
      "type": "string",
      "enum": [
        "sep",
        "mep",
        "turboprop",
        "jet",
        "helicopter"
      ],
      "default": "sep",
      "description": "Aircraft class \u2014 determines which blueprint template is used"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "current_step_id": {
      "type": "string",
      "description": "ID of the current active step"
    },
    "progress_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "steps": {
      "type": "array",
      "description": "Ordered pipeline milestones \u2014 the 'spider' chain",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "verification",
              "document",
              "valuation",
              "financial",
              "inspection",
              "legal",
              "closing"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "skipped",
              "blocked"
            ],
            "default": "pending"
          },
          "ai_driven": {
            "type": "boolean",
            "default": false
          },
          "function_name": {
            "type": "string",
            "description": "Backend function to invoke for one-click execution"
          },
          "result_data": {
            "type": "object",
            "description": "Function output or AI review report"
          },
          "ai_notes": {
            "type": "string",
            "description": "AI-generated notes or review summary"
          },
          "prerequisite_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_by": {
            "type": "string"
          },
          "blocked_reason": {
            "type": "string"
          }
        }
      }
    },
    "broker_id": {
      "type": "string",
      "description": "User ID of assigned broker"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_email": {
      "type": "string"
    },
    "sale_amount": {
      "type": "number"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for search visibility and SEO"
    }
  },
  "required": [
    "registration",
    "aircraft_class"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.broker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.broker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}