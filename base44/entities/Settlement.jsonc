{
  "name": "Settlement",
  "type": "object",
  "properties": {
    "batch_code": {
      "type": "string",
      "description": "Human-readable batch code (e.g. STL-2026-04-001)"
    },
    "payee_email": {
      "type": "string",
      "description": "Email of the payee receiving this batch"
    },
    "payee_role": {
      "type": "string",
      "enum": [
        "issuer",
        "marketplace",
        "broker",
        "sub_broker"
      ]
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "total_amount": {
      "type": "number",
      "description": "Sum of all commissions in this batch"
    },
    "entry_count": {
      "type": "number",
      "description": "Number of commission entries included"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "paid",
        "cancelled"
      ],
      "default": "draft"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "wire",
        "ach",
        "stripe",
        "manual",
        "credit"
      ],
      "description": "How the payout was delivered"
    },
    "payment_reference": {
      "type": "string",
      "description": "External payment reference (wire ID, Stripe payout, etc.)"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_by": {
      "type": "string",
      "description": "Email of admin who marked it paid"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "batch_code",
    "payee_email",
    "total_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.payee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}