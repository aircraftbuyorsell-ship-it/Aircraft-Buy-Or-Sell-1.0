{
  "name": "SkillDefinition",
  "type": "object",
  "properties": {
    "skill_id": {
      "type": "string",
      "description": "Unique skill identifier with version (e.g. abos.skill.opex.v1)"
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "description": "Human-readable skill name"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "What the skill calculates"
    },
    "version": {
      "type": "string",
      "default": "v1",
      "description": "Skill version tag"
    },
    "rfc_number": {
      "type": "string",
      "description": "Associated RFC number (e.g. RFC-211)"
    },
    "batch": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Processing batch: A=Foundation, B=OPEX, C=Upgrade, D=Investment"
    },
    "function_name": {
      "type": "string",
      "description": "Backend function that executes this skill"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "deterministic",
        "tool_calling",
        "narrative",
        "hybrid"
      ],
      "default": "deterministic",
      "description": "Determines LLM routing: deterministic=no LLM, tool_calling=GPT o3, narrative=Llama 4, hybrid=both"
    },
    "input_schema": {
      "type": "object",
      "description": "JSON Schema contract for inputs"
    },
    "output_schema": {
      "type": "object",
      "description": "JSON Schema contract for outputs"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Data sources the skill reads from"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other skill_ids this skill depends on"
    },
    "credit_cost": {
      "type": "number",
      "minimum": 0,
      "default": 1,
      "description": "ABOS Credits charged per invocation"
    },
    "agent_callable": {
      "type": "boolean",
      "default": true,
      "description": "Whether the AI Broker Agent can invoke this skill"
    },
    "latency_budget_ms": {
      "type": "number",
      "description": "Target max execution time in milliseconds"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "model_primary": {
      "type": "string",
      "description": "Primary LLM model (for D-batch skills)"
    },
    "model_fallback_1": {
      "type": "string"
    },
    "model_fallback_2": {
      "type": "string"
    }
  },
  "required": [
    "skill_id",
    "name",
    "function_name",
    "batch",
    "task_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "id": {
        "$exists": true
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}