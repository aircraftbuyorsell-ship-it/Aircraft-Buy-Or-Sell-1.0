{
  "name": "StartupProject",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "maxLength": 150,
      "description": "Project or startup name"
    },
    "tagline": {
      "type": "string",
      "maxLength": 200,
      "description": "One-line elevator pitch"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Full project description"
    },
    "category": {
      "type": "string",
      "enum": [
        "marketplace",
        "analytics_valuation",
        "compliance_trust",
        "cross_border_logistics",
        "ai_automation",
        "maintenance_tracking",
        "fractional_ownership",
        "sustainability",
        "financing_escrow",
        "training_crew",
        "other"
      ],
      "description": "Project category"
    },
    "stage": {
      "type": "string",
      "enum": [
        "idea",
        "mvp",
        "beta",
        "live",
        "scaling"
      ],
      "default": "idea",
      "description": "Development stage"
    },
    "seeking": {
      "type": "string",
      "enum": [
        "investment",
        "collaboration",
        "mentorship",
        "customers",
        "partners",
        "team_members"
      ],
      "default": "investment",
      "description": "What the project is seeking"
    },
    "funding_goal": {
      "type": "number",
      "description": "Funding goal in EUR"
    },
    "funding_raised": {
      "type": "number",
      "default": 0,
      "description": "Amount already raised"
    },
    "team_size": {
      "type": "number",
      "description": "Number of team members"
    },
    "location": {
      "type": "string",
      "maxLength": 200,
      "description": "City, Country"
    },
    "website_url": {
      "type": "string",
      "description": "Project website"
    },
    "logo_url": {
      "type": "string",
      "description": "Project logo image URL"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Public contact email"
    },
    "founder_name": {
      "type": "string",
      "maxLength": 150,
      "description": "Founder or primary contact name"
    },
    "ati_integrated": {
      "type": "boolean",
      "default": false,
      "description": "Integrates with ATI Standard"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "active",
        "funded",
        "archived"
      ],
      "default": "pending",
      "description": "Listing status"
    },
    "submitted_by": {
      "type": "string",
      "description": "Email of submitter"
    },
    "interest_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Number of expressions of interest"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    }
  },
  "required": [
    "project_name",
    "category",
    "seeking",
    "contact_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": {
            "$in": [
              "approved",
              "active",
              "funded"
            ]
          }
        },
        {
          "data.submitted_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.submitted_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}