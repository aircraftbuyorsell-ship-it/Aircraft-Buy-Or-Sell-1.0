{
  "name": "SuspensionEvent",
  "type": "object",
  "properties": {
    "appeal_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for user to appeal suspension"
    },
    "appeal_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When user submitted an appeal"
    },
    "appeal_text": {
      "type": "string",
      "maxLength": 1000,
      "description": "User's appeal message"
    },
    "automatic_reactivation": {
      "type": "boolean",
      "description": "Whether account auto-reactivates after period"
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When decision was made (on appeal)"
    },
    "is_permanent": {
      "type": "boolean",
      "description": "Whether suspension is permanent"
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Admin notes about the suspension"
    },
    "reactivated_by_email": {
      "type": "string",
      "description": "Email of admin who reactivated account"
    },
    "reactivation_reason": {
      "type": "string",
      "description": "Reason for reactivation"
    },
    "reactivation_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When account was reactivated"
    },
    "scheduled_reactivation": {
      "type": "string",
      "format": "date-time",
      "description": "Date account will auto-reactivate"
    },
    "status": {
      "type": "string",
      "description": "Current suspension status",
      "enum": [
        "active",
        "appealed",
        "appeal_approved",
        "appeal_rejected",
        "reactivated",
        "expired"
      ]
    },
    "suspended_by_email": {
      "type": "string",
      "description": "Email of admin who suspended account"
    },
    "suspended_reason": {
      "type": "string",
      "description": "Reason for suspension",
      "enum": [
        "terms_violation",
        "payment_failure",
        "fraud_suspected",
        "manual_admin",
        "compliance_hold",
        "appeal_process"
      ]
    },
    "suspension_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When account was suspended"
    },
    "user_email": {
      "type": "string",
      "description": "Email of suspended user"
    }
  },
  "required": [
    "user_email",
    "suspended_by_email",
    "suspended_reason",
    "suspension_timestamp",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}