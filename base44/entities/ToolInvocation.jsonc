{
  "name": "ToolInvocation",
  "type": "object",
  "properties": {
    "tool_integration_id": {
      "type": "string",
      "relationType": "ToolIntegration",
      "description": "The tool that was invoked"
    },
    "tool_name": {
      "type": "string",
      "description": "Snapshot of tool name at invocation time"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user who invoked the tool"
    },
    "tokens_charged": {
      "type": "number",
      "minimum": 0,
      "description": "Tokens deducted from the user for this call"
    },
    "platform_revenue": {
      "type": "number",
      "minimum": 0,
      "description": "Platform's share of tokens earned"
    },
    "developer_revenue": {
      "type": "number",
      "minimum": 0,
      "description": "Developer's share of tokens earned"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "failed",
        "refunded"
      ],
      "default": "pending",
      "description": "Invocation result status"
    },
    "request_payload": {
      "type": "object",
      "description": "Payload sent to the external tool webhook"
    },
    "response_payload": {
      "type": "object",
      "description": "Response received from the external tool webhook"
    },
    "error_message": {
      "type": "string",
      "maxLength": 1000,
      "description": "Error details if status=failed"
    },
    "http_status_code": {
      "type": "number",
      "description": "HTTP status code returned by the external webhook"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Round-trip latency in milliseconds"
    },
    "invoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the invocation was initiated"
    },
    "developer_id": {
      "type": "string",
      "description": "Email of the tool developer (denormalized for payout queries)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for search visibility and SEO"
    }
  },
  "required": [
    "tool_integration_id",
    "user_email",
    "tokens_charged",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.developer_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}