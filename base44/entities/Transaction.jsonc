{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "aircraft_id": {
      "type": "string",
      "relationType": "Aircraft"
    },
    "buyer_id": {
      "type": "string",
      "relationType": "User"
    },
    "seller_id": {
      "type": "string",
      "relationType": "User"
    },
    "verification_session_id": {
      "type": "string",
      "relationType": "VerificationSession"
    },
    "listing_id": {
      "type": "string",
      "relationType": "AircraftListing"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "qualified",
        "verification",
        "due_diligence",
        "pre_buy",
        "offer",
        "negotiation",
        "contract",
        "escrow",
        "closing",
        "completed",
        "cancelled"
      ],
      "default": "new"
    },
    "deal_value": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "aircraft_id"
  ]
}