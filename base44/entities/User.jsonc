{
  "name": "User",
  "type": "object",
  "properties": {
    "referred_by_email": {
      "type": "string",
      "description": "Email of the user who referred this account (captured at first login if ?ref=... is in the URL)"
    },
    "personalization_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether premium branding personalization is active"
    },
    "company_name": {
      "type": "string",
      "description": "Company name for premium branding"
    },
    "brand_logo_url": {
      "type": "string",
      "description": "Uploaded brand logo URL"
    },
    "brand_primary_color": {
      "type": "string",
      "description": "Primary brand color"
    },
    "brand_accent_color": {
      "type": "string",
      "description": "Accent brand color"
    },
    "brand_font": {
      "type": "string",
      "description": "Selected brand font family"
    }
  },
  "required": [
    "referred_by_email",
    "company_name",
    "brand_logo_url",
    "brand_primary_color",
    "brand_accent_color",
    "brand_font"
  ]
}