{
  "name": "UserBehavior",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the tracked user"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free_explorer",
        "pro",
        "enterprise"
      ],
      "default": "free_explorer",
      "description": "Current subscription tier"
    },
    "tokens_remaining": {
      "type": "number",
      "default": 0,
      "description": "Raw token balance (1 token = 5 displayed credits)"
    },
    "tokens_purchased_total": {
      "type": "number",
      "default": 0,
      "description": "Lifetime tokens purchased"
    },
    "engagement_score": {
      "type": "number",
      "default": 0,
      "description": "Internal behavioral score 0-100"
    },
    "session_count": {
      "type": "number",
      "default": 0,
      "description": "Total sessions"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "Last activity timestamp"
    },
    "verification_paid": {
      "type": "boolean",
      "default": false,
      "description": "Completed first paid verification step"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "at": {
            "type": "string"
          }
        }
      },
      "description": "Recent behavioral events (capped)"
    },
    "limits_hit": {
      "type": "object",
      "description": "Counts of feature-gate hits"
    },
    "last_offer_shown_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time a marketing offer was shown"
    },
    "last_offer_dismissed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time an offer was dismissed"
    },
    "active_offer": {
      "type": "object",
      "description": "Current personalized offer { code, discount_pct, expires_at }"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}