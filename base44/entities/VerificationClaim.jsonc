{
  "name": "VerificationClaim",
  "type": "object",
  "properties": {
    "aircraft_id": {
      "type": "string",
      "relationType": "Aircraft"
    },
    "verification_session_id": {
      "type": "string",
      "relationType": "VerificationSession"
    },
    "source": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "observed_value": {
      "type": "string"
    },
    "normalized_value": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "conflict",
        "unverified",
        "review_required"
      ],
      "default": "unverified"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object"
    },
    "module": {
      "type": "string",
      "enum": [
        "registry",
        "identity",
        "ownership",
        "activity",
        "service",
        "document",
        "expert",
        "system"
      ]
    }
  },
  "required": [
    "aircraft_id",
    "claim",
    "source"
  ]
}