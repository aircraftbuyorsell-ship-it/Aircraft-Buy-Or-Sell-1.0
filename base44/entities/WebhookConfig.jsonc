{
  "name": "WebhookConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 100,
      "description": "Friendly name for this webhook"
    },
    "url": {
      "type": "string",
      "description": "Target URL that receives the webhook POST"
    },
    "secret": {
      "type": "string",
      "description": "Optional secret for HMAC signature verification"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of event types that trigger this webhook"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this webhook is currently enabled"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the admin who created this webhook"
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the last successful delivery"
    },
    "last_status": {
      "type": "number",
      "description": "HTTP status code from the last delivery attempt"
    },
    "trigger_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Total successful deliveries"
    }
  },
  "required": [
    "name",
    "url",
    "events"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}