{
  "name": "WorkflowRun",
  "type": "object",
  "properties": {
    "run_id": { "type": "string", "description": "Stable run identifier used across steps, tasks, approvals and audit records" },
    "workflow_key": { "type": "string", "description": "AgentWorkflow.workflow_key this run executes" },
    "workflow_version": { "type": "string" },
    "state": {
      "type": "string",
      "enum": ["CREATED", "PLANNED", "ASSIGNED", "RUNNING", "WAITING", "REVIEW", "APPROVAL_REQUIRED", "EXECUTING", "VERIFYING", "COMPLETED", "FAILED", "BLOCKED", "ESCALATED", "CANCELLED"],
      "default": "CREATED",
      "description": "Workflow state machine. A run never silently disappears."
    },
    "owner_agent_key": { "type": "string" },
    "orchestrator_key": { "type": "string" },
    "assigned_agent_key": { "type": "string" },
    "subject_type": { "type": "string", "description": "aircraft | listing | customer | incident | release | provider | other" },
    "subject_id": { "type": "string", "description": "Stable internal id of the subject. For aircraft this is aircraft_id, never the registration." },
    "subject_label": { "type": "string", "description": "Human-readable label (registration, serial, customer email)" },
    "inputs": { "type": "object" },
    "outputs": { "type": "object" },
    "required_skills": { "type": "array", "items": { "type": "string" }, "description": "Snapshot of the mandatory skills at run start, so later workflow edits cannot retroactively weaken this run" },
    "optional_skills": { "type": "array", "items": { "type": "string" } },
    "skill_results": { "type": "array", "items": { "type": "object" }, "description": "[{ skill_id, status, attempt, confidence, at }] — the completion gate evaluates this list" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "sources": { "type": "array", "items": { "type": "object" } },
    "conflicts": { "type": "array", "items": { "type": "object" }, "description": "Unresolved source disagreements. Never silently overwritten." },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "retry_count": { "type": "number", "default": 0, "minimum": 0 },
    "delegation_path": { "type": "array", "items": { "type": "string" }, "description": "Ordered agent_key chain. A repeat means circular delegation and blocks the run." },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"], "default": "P2" },
    "deadline": { "type": "string", "format": "date-time" },
    "state_history": { "type": "array", "items": { "type": "object" }, "description": "[{ from, to, at, actor, reason }]" },
    "correlation_id": { "type": "string" },
    "triggered_by": { "type": "string", "description": "Email of the human, or 'system', or the agent_key that started this run" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "last_error": { "type": "string", "maxLength": 2000 }
  },
  "required": ["run_id", "workflow_key", "state"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
