{
  "name": "Escrow \u2014 Email Notifications on Status Change",
  "description": "Sends email notifications to buyer, seller and broker when escrow transaction status changes",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EscrowTransaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "escrow_email_notifications_on_status_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "escrowNotify",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}