{
  "name": "Meta Ads Budget Optimizer",
  "description": "Automatically adjusts Meta Ads ad set daily budgets based on aircraft lead conversion performance (CPL vs target). Runs daily at 09:00 Prague time.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "meta_ads_budget_optimizer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "metaAdsBudgetOptimizer",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}