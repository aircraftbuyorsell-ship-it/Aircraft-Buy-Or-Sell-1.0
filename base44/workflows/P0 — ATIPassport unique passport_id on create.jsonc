{
  "name": "P0 — ATIPassport unique passport_id on create",
  "description": "P0 guard — when an ATIPassport is created, if another exists with the same passport_id (provider-sourced passports only), merge into the oldest (fill empty identity/provenance fields, never touch scoring) and delete the duplicate.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ATIPassport"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "p0_atipassport_unique_passport_id_on_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceUniqueOnCreate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
