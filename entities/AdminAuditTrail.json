{
  "properties": {
    "action_category": {
      "description": "Type of admin action",
      "enum": [
        "user_management",
        "tier_management",
        "content_moderation",
        "escrow_override",
        "security_incident",
        "compliance_action",
        "system_config",
        "payment_adjustment"
      ],
      "type": "string"
    },
    "action_detail": {
      "description": "Detailed description of what was done",
      "maxLength": 1000,
      "type": "string"
    },
    "actor_email": {
      "description": "Admin who performed the action",
      "type": "string"
    },
    "actor_role": {
      "description": "Role of the admin at time of action",
      "enum": [
        "admin",
        "super_admin"
      ],
      "type": "string"
    },
    "affected_entity_id": {
      "description": "ID of the entity affected",
      "type": "string"
    },
    "affected_entity_type": {
      "description": "Type of entity affected (User, AircraftListing, ATICard, etc.)",
      "type": "string"
    },
    "before_snapshot": {
      "description": "State of entity before action (JSON)",
      "type": "object"
    },
    "after_snapshot": {
      "description": "State of entity after action (JSON)",
      "type": "object"
    },
    "ip_address_hash": {
      "description": "Hashed IP of the admin",
      "type": "string"
    },
    "risk_level": {
      "description": "Severity of this action",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "timestamp": {
      "description": "When the action occurred",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "action_category",
    "actor_email",
    "timestamp"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": {
      "user_condition": {
        "role": [
          "admin",
          "super_admin"
        ]
      }
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  },
  "type": "object",
  "name": "AdminAuditTrail"
}