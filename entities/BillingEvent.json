{
  "properties": {
    "amount": {
      "description": "Amount in USD (positive=charge, negative=refund)",
      "type": "number"
    },
    "billing_period_end": {
      "description": "End of billing period",
      "format": "date",
      "type": "string"
    },
    "billing_period_start": {
      "description": "Start of billing period",
      "format": "date",
      "type": "string"
    },
    "currency": {
      "default": "USD",
      "description": "Currency",
      "enum": [
        "USD",
        "EUR"
      ],
      "type": "string"
    },
    "description": {
      "description": "Human-readable description",
      "maxLength": 200,
      "type": "string"
    },
    "event_type": {
      "description": "Type of billing event",
      "enum": [
        "subscription_charge",
        "tier_upgrade_charge",
        "tier_upgrade_refund",
        "tier_downgrade_refund",
        "overuse_charge",
        "manual_adjustment",
        "refund"
      ],
      "type": "string"
    },
    "invoice_number": {
      "description": "Invoice/receipt number",
      "type": "string"
    },
    "next_billing_date": {
      "description": "When next charge is due",
      "format": "date",
      "type": "string"
    },
    "payment_method": {
      "description": "How payment was made",
      "enum": [
        "stripe_card",
        "stripe_bank",
        "manual_invoice",
        "credit"
      ],
      "type": "string"
    },
    "payment_status": {
      "description": "Status of payment",
      "enum": [
        "pending",
        "processing",
        "succeeded",
        "failed",
        "refunded"
      ],
      "type": "string"
    },
    "processed_at": {
      "description": "When payment was processed",
      "format": "date-time",
      "type": "string"
    },
    "related_tier_change": {
      "description": "Reference to TierChange entity (if applicable)",
      "type": "string"
    },
    "stripe_charge_id": {
      "description": "Stripe charge ID (for lookups)",
      "type": "string"
    },
    "user_email": {
      "description": "Email of user",
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "event_type",
    "amount",
    "payment_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": [
              "admin",
              "super_admin"
            ]
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  },
  "type": "object",
  "name": "BillingEvent"
}