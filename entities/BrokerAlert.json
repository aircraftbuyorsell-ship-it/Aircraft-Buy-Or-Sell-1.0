{
  "name": "BrokerAlert",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the broker who owns this alert"
    },
    "name": {
      "type": "string",
      "maxLength": 150,
      "description": "Friendly alert name"
    },
    "dealer_location": {
      "type": "string",
      "relationType": "DealerLocation",
      "description": "Linked dealer location (geo-fence origin)"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "aircraft_nearby",
        "deal_score_threshold",
        "ati_score_threshold",
        "new_listing_match",
        "price_drop"
      ],
      "default": "aircraft_nearby",
      "description": "What triggers this alert"
    },
    "make_filter": {
      "type": "string",
      "description": "Filter by aircraft make (partial match)"
    },
    "model_filter": {
      "type": "string",
      "description": "Filter by aircraft model (partial match)"
    },
    "year_min": {
      "type": "number",
      "minimum": 1940,
      "maximum": 2035
    },
    "year_max": {
      "type": "number",
      "minimum": 1940,
      "maximum": 2035
    },
    "max_price": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum asking price USD"
    },
    "min_ati_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 120,
      "description": "Minimum ATI score to trigger"
    },
    "min_deal_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Minimum deal score (0-10) to trigger"
    },
    "radius_nm": {
      "type": "number",
      "minimum": 1,
      "maximum": 500,
      "default": 50,
      "description": "Radius in NM around dealer location to watch"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "in_app",
        "webhook"
      ],
      "default": "in_app",
      "description": "Notification delivery channel"
    },
    "webhook_url": {
      "type": "string",
      "description": "Webhook endpoint URL (if channel=webhook)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last trigger"
    },
    "trigger_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Total times this alert has fired"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "owner_email",
    "name",
    "trigger_type"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}