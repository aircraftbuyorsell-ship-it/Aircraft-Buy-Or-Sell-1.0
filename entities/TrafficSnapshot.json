{
  "name": "TrafficSnapshot",
  "type": "object",
  "properties": {
    "region_key": {
      "type": "string",
      "description": "Unique region or bounds key for cached traffic"
    },
    "region_label": {
      "type": "string",
      "description": "Human-readable region label"
    },
    "bounds": {
      "type": "object",
      "description": "Map bounds used for the OpenSky request"
    },
    "aircraft_json": {
      "type": "string",
      "description": "Cached aircraft payload as JSON"
    },
    "opensky_time": {
      "type": "number",
      "description": "OpenSky response timestamp"
    },
    "total_raw": {
      "type": "number",
      "description": "Raw aircraft count returned by OpenSky"
    },
    "refreshed_by": {
      "type": "string",
      "description": "Email of user who refreshed the cache"
    },
    "refreshed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this cache was refreshed"
    }
  },
  "required": [
    "region_key",
    "aircraft_json",
    "refreshed_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}