{
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user (unique identifier)"
    },
    "display_name": {
      "type": "string",
      "maxLength": 100,
      "description": "Public display name"
    },
    "bio": {
      "type": "string",
      "maxLength": 500,
      "description": "User bio/description"
    },
    "profile_image_url": {
      "type": "string",
      "description": "Avatar image URL"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "super_admin",
        "moderator",
        "dealer",
        "broker",
        "marketplace",
        "buyer",
        "seller",
        "viewer"
      ],
      "default": "viewer",
      "description": "User role"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free_explorer",
        "pro",
        "enterprise"
      ],
      "default": "free_explorer",
      "description": "Subscription tier"
    },
    "sub_tier": {
      "type": "string",
      "enum": [
        "starter",
        "plus",
        "premium",
        "scale",
        "elite",
        "none"
      ],
      "default": "none",
      "description": "Sub-tier level"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deleted"
      ],
      "default": "active",
      "description": "Account status"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When account was suspended"
    },
    "suspension_reason": {
      "type": "string",
      "maxLength": 1000,
      "description": "Why account was suspended"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful authentication"
    },
    "last_ip_hash": {
      "type": "string",
      "description": "Hashed IP of last login"
    },
    "custom_domain": {
      "type": "string",
      "maxLength": 255,
      "description": "Custom domain for white-label (enterprise only)"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "can_create_ati_card",
          "can_modify_ati_card",
          "can_delete_ati_card",
          "can_moderate_reviews",
          "can_access_admin_panel",
          "can_create_escrow",
          "can_settle_escrow",
          "can_invite_editors",
          "can_access_api",
          "can_white_label"
        ]
      },
      "default": [],
      "description": "Fine-grained permission flags"
    },
    "feature_flags": {
      "type": "object",
      "description": "Feature access {escrow_enabled: true, white_label: false}"
    },
    "metadata": {
      "type": "object",
      "description": "Custom user metadata"
    }
  },
  "required": [
    "user_email",
    "role",
    "tier"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "UserProfile"
}