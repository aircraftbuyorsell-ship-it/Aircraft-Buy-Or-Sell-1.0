{
  "name": "VaultDocument",
  "type": "object",
  "properties": {
    "ati_card": {
      "type": "string",
      "relationType": "ATICard",
      "description": "Linked ATI Card"
    },
    "listing": {
      "type": "string",
      "relationType": "AircraftListing",
      "description": "Linked aircraft listing"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "logbook",
        "maintenance_record",
        "airworthiness_cert",
        "registration_cert",
        "noise_cert",
        "weight_balance",
        "radio_license",
        "insurance_cert",
        "title_document",
        "bill_of_sale",
        "inspection_report",
        "engine_log",
        "propeller_log",
        "stc_approval",
        "ad_compliance",
        "service_bulletin",
        "paint_interior_log",
        "damage_history",
        "lease_agreement",
        "co_ownership_agreement",
        "shared_ownership_deed",
        "other"
      ],
      "description": "Document category"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "Document title/name"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Document description"
    },
    "file_url": {
      "type": "string",
      "description": "Encrypted document URL (stored on ABOS/Polygon vault)"
    },
    "file_hash": {
      "type": "string",
      "maxLength": 128,
      "description": "SHA-256 hash of the document for integrity verification"
    },
    "polygon_tx_hash": {
      "type": "string",
      "maxLength": 128,
      "description": "Polygon blockchain transaction hash (immutable anchor)"
    },
    "polygon_block_number": {
      "type": "number",
      "description": "Polygon block number where the document hash was anchored"
    },
    "polygon_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Polygon anchor was confirmed"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending",
      "description": "Verification status by certified entity"
    },
    "verified_by": {
      "type": "string",
      "maxLength": 200,
      "description": "Certified entity that verified (FAA/EASA/IATA/CAA reference)"
    },
    "certifying_authority": {
      "type": "string",
      "enum": [
        "FAA",
        "EASA",
        "IATA",
        "CAA",
        "TC",
        "ANAC",
        "CAAC",
        "other"
      ],
      "description": "Certifying authority"
    },
    "certifier_license": {
      "type": "string",
      "maxLength": 100,
      "description": "Certifier license/certificate number (e.g. A&P, IA, CAMO)"
    },
    "verification_date": {
      "type": "string",
      "format": "date",
      "description": "When the document was verified"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Document expiry date (if applicable)"
    },
    "is_shared_ownership_doc": {
      "type": "boolean",
      "default": false,
      "description": "Whether this document relates to shared ownership"
    },
    "shared_ownership_parties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses of co-owners with access"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared_owners",
        "verified_viewers",
        "public"
      ],
      "default": "private",
      "description": "Who can view this document"
    },
    "uploaded_by": {
      "type": "string",
      "description": "Email of the user who uploaded"
    },
    "file_size_bytes": {
      "type": "number",
      "description": "Original file size in bytes"
    },
    "mime_type": {
      "type": "string",
      "maxLength": 100,
      "description": "File MIME type"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000,
      "description": "Internal notes"
    }
  },
  "required": [
    "ati_card",
    "document_type",
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "data.visibility": "public"
        },
        {
          "data.shared_ownership_parties": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}