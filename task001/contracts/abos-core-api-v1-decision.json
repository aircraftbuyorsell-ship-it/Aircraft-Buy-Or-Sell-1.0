{
  "schema_version": "1.0.0",
  "status": "canonical_draft",
  "canonical_contract": {
    "openapi": "3.1.0",
    "base_path": "/api/v1",
    "response_envelope": "operation_specific",
    "error_schema": "APIError",
    "authentication": ["Authorization: Bearer <token>", "X-ABOS-API-Key: <key>"],
    "operations": [
      { "method": "POST", "path": "/api/v1/search", "operation_id": "searchListings", "scope": "search:read" },
      { "method": "GET", "path": "/api/v1/aircraft/{aircraft_id}", "operation_id": "getAircraft", "scope": "listings:read" },
      { "method": "GET", "path": "/api/v1/listings/{listing_id}", "operation_id": "getListing", "scope": "listings:read" },
      { "method": "POST", "path": "/api/v1/intelligence/valuate", "operation_id": "requestValuation", "scope": "intelligence:request" }
    ]
  },
  "legacy_gateway": {
    "method": "POST",
    "path": "/functions/abosCoreApi",
    "api_key_header": "x-abos-key",
    "status": "compatibility_only",
    "sdk_exposure": false,
    "mcp_exposure": false,
    "operations": ["keys.create", "keys.list", "keys.revoke", "search", "valuate", "intelligence.extract", "listings.get", "listings.list", "listings.create"]
  },
  "compatibility_mappings": [
    { "legacy": "search", "canonical": "POST /api/v1/search", "mode": "adapt", "notes": "Map params.query to query; translate matches to results and add pagination/provenance." },
    { "legacy": "valuate", "canonical": "POST /api/v1/intelligence/valuate", "mode": "guarded_adapt", "notes": "Never translate untraceable LLM memory into a complete valuation." },
    { "legacy": "listings.get", "canonical": "GET /api/v1/listings/{listing_id}", "mode": "adapt", "notes": "Resolve internal ID to stable public listing_id before returning a public DTO." },
    { "legacy": "listings.list", "canonical": "POST /api/v1/search", "mode": "adapt", "notes": "Translate structured filters into deterministic search constraints." },
    { "legacy": "keys.create", "canonical": null, "mode": "legacy_only", "notes": "Defer API-key lifecycle contract." },
    { "legacy": "keys.list", "canonical": null, "mode": "legacy_only", "notes": "Defer API-key lifecycle contract." },
    { "legacy": "keys.revoke", "canonical": null, "mode": "legacy_only", "notes": "Defer API-key lifecycle contract." },
    { "legacy": "intelligence.extract", "canonical": null, "mode": "legacy_only", "notes": "Requires a separate reviewed capability contract." },
    { "legacy": "listings.create", "canonical": null, "mode": "legacy_only", "notes": "Requires ownership, authorization and idempotency design." }
  ],
  "invariants": {
    "public_ids_only": true,
    "internal_ids_forbidden": true,
    "deterministic_retrieval": true,
    "source_provenance_required": true,
    "valuation_without_traceable_sources": "insufficient_data",
    "sanitized_errors": true,
    "request_id_required": true,
    "legacy_gateway_must_remain_available_during_coexistence": true
  }
}
