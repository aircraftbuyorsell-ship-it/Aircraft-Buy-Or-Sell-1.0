STRIPE_WEBHOOK_SECRET=<SET_LOCAL_SECRET>
OPENAI_API_KEY=<SET_LOCAL_SECRET>
ANTHROPIC_API_KEY=<SET_LOCAL_SECRET>
GOOGLE_API_KEY=<SET_LOCAL_SECRET>
HUGGINGFACE_API_KEY=<SET_LOCAL_SECRET>
NVIDIA_API_KEY=<SET_LOCAL_SECRET>
OPENSKY_CLIENT_ID=<SET_LOCAL_SECRET>
OPENSKY_CLIENT_SECRET=<SET_LOCAL_SECRET>
